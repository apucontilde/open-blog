# cp .env.example .env  — then generate a real key:
#   openssl rand -hex 32
SESSION_KEY=

# seed account (dev only)
SEED_EMAIL=admin@example.com
SEED_PASSWORD=changeme123
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Demo Blog

# Tailscale (only needed for: docker compose --profile tailscale up -d)
# Create a reusable auth key at https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Set "true" when the app is served over Tailscale HTTPS so the session cookie
# is marked Secure. Note: with "true", plain http://localhost login won't work.
COOKIE_SECURE=false
